# Copy to .env.local for local use. On Vercel, add the same keys in Project > Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=https://drsapnadentalrohtak.com

# Supabase (Project Settings > API). Use the SECRET / service_role key. Never expose it in browser code.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Cloudinary (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini chatbot (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Admin panel login (/admin)
ADMIN_PASSWORD=
ADMIN_SECRET=put-a-long-random-string-here
